# From https://discord.com/developers/applications > your app > Bot > Reset Token
DISCORD_TOKEN=
# Optional. Commands are registered globally (every server). If an older version registered them to one server,
# put that server's ID here to clear the old copies so they don't show twice.
GUILD_ID=
# Folder of music files for /local
MUSIC_DIR=~/Music
# Seconds before leaving when nothing is playing or nobody is in the channel
IDLE_TIMEOUT=300
DEFAULT_VOLUME=50
MAX_PLAYLIST_IMPORT=200
# Web mixer: local port, and the public https address people open it at (needed for /mixer links).
# On your own computer only: PUBLIC_URL=http://127.0.0.1:8765
MIXER_PORT=8765
PUBLIC_URL=
# Docker only, to share the mixer through ngrok (docker compose --profile mixer up -d):
# your ngrok authtoken and free static domain from dashboard.ngrok.com. Set PUBLIC_URL=https://<that domain> too.
NGROK_AUTHTOKEN=
NGROK_DOMAIN=
