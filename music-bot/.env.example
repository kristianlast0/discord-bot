# From https://discord.com/developers/applications > your app > Bot > Reset Token
DISCORD_TOKEN=
# Your server's ID (Discord settings > Advanced > Developer Mode, then right-click the server > Copy Server ID).
# Makes slash commands appear straight away.
GUILD_ID=
# Folder of music files for /local
MUSIC_DIR=~/Music
# Seconds before leaving when nothing is playing or nobody is in the channel
IDLE_TIMEOUT=300
DEFAULT_VOLUME=50
MAX_PLAYLIST_IMPORT=200
# Web mixer: local port, and the public https address ngrok gives it (needed for /mixer links)
MIXER_PORT=8765
PUBLIC_URL=
